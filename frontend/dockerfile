# Use the official Python image from the Docker Hub
FROM node:22-alpine

# Set the working directory
WORKDIR /app

# Copy the requirements file
COPY ./package.json .

# Install dependencies
RUN npm install 

# Copy the application code
COPY . .

# Expose the API port
EXPOSE 5173

# Start the React application
CMD ["npm", "run", "dev", "--", "--host"]
